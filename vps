#!/data/data/com.termux/files/usr/bin/bash

set -e

BASE_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ ! -f "$BASE_DIR/config.sh" ]; then
    echo "Chưa có cấu hình."
    echo "Hãy chạy:"
    echo "bash install.sh"
    exit 1
fi

source "$BASE_DIR/config.sh"

API="https://api.github.com"
REPO="$GH_USER/$GH_REPO"

gh_api() {
    curl -sS \
        -H "Accept: application/vnd.github+json" \
        -H "Authorization: Bearer $GH_TOKEN" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "$@"
}

check_repo() {
    RESULT=$(gh_api "$API/repos/$REPO")

    if echo "$RESULT" | jq -e '.id' >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

status() {
    echo
    echo "========== TRẠNG THÁI =========="

    RUNS=$(gh_api "$API/repos/$REPO/actions/runs?per_page=5")

    echo "$RUNS" |
        jq -r '
        .workflow_runs[] |
        "\(.id) | \(.name) | \(.status) | \(.conclusion // "-")"
        '

    echo
}

start() {
    echo
    echo "Đang khởi động VPS..."

    RESULT=$(gh_api \
        -X POST \
        "$API/repos/$REPO/actions/workflows/vps.yml/dispatches" \
        -d '{"ref":"main"}')

    if [ -z "$RESULT" ]; then
        echo "Đã gửi yêu cầu khởi động."
    else
        echo "$RESULT"
    fi

    echo
    echo "Kiểm tra:"
    echo "./vps status"
}

stop() {
    echo
    read -p "Nhập Run ID cần dừng: " RUN_ID

    if [ -z "$RUN_ID" ]; then
        echo "Run ID không hợp lệ."
        return
    fi

    gh_api \
        -X POST \
        "$API/repos/$REPO/actions/runs/$RUN_ID/cancel"

    echo
    echo "Đã gửi yêu cầu dừng workflow."
}

logs() {
    echo
    read -p "Nhập Run ID: " RUN_ID

    echo
    echo "Thông tin workflow:"
    gh_api "$API/repos/$REPO/actions/runs/$RUN_ID" |
        jq '{
            id,
            name,
            status,
            conclusion,
            created_at,
            updated_at,
            html_url
        }'
}

while true; do

    clear

    echo "======================================"
    echo "        FREE VPS LAUNCHER"
    echo "======================================"
    echo "Repository: $REPO"
    echo
    echo "1. 🚀 Khởi động VPS"
    echo "2. 📊 Xem trạng thái"
    echo "3. 🛑 Dừng VPS"
    echo "4. 📜 Xem thông tin Run"
    echo "5. ❌ Thoát"
    echo
    read -p "Chọn: " CHOICE

    case "$CHOICE" in

        1)
            if check_repo; then
                start
            else
                echo "Không truy cập được repository."
                echo "Kiểm tra username, repository hoặc token."
            fi
            read -p "Enter để tiếp tục..."
            ;;

        2)
            status
            read -p "Enter để tiếp tục..."
            ;;

        3)
            stop
            read -p "Enter để tiếp tục..."
            ;;

        4)
            logs
            read -p "Enter để tiếp tục..."
            ;;

        5)
            exit 0
            ;;

        *)
            echo "Lựa chọn không hợp lệ."
            sleep 1
            ;;
    esac

done

